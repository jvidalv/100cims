{
  "name": "100cims-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "app": "yarn workspace @100cims/app",
    "api": "yarn workspace @100cims/api",
    "dev:app": "yarn workspace @100cims/app start",
    "dev:api": "yarn workspace @100cims/api dev",
    "build:app": "yarn workspace @100cims/app build",
    "build:api": "yarn workspace @100cims/api build",
    "lint": "yarn workspaces run lint",
    "type-check": "yarn workspaces run type-check",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "node-gyp": "^12.2.0"
  },
  "resolutions": {
    "lightningcss": "1.30.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-screens": "4.25.1"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=1.22.19"
  }
}
