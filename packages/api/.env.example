# 100cims API Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================================================
# DATABASE (Required)
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/100cims

# ============================================================================
# AUTHENTICATION (Required)
# ============================================================================
# Secret key for JWT token signing and verification (shared between Elysia JWT and NextAuth)
# Generate a strong random string (at least 32 characters)
# Example: openssl rand -base64 32
AUTH_SECRET=your-super-secret-jwt-key-here

# Google OAuth credentials for admin web sign-in (NextAuth)
# Create a "Web application" OAuth client in Google Cloud Console and add redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<prod-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# ============================================================================
# AWS S3 (Required for image uploads)
# ============================================================================
# AWS region where your S3 bucket is located
AWS_BUCKET_REGION=us-east-1

# Name of your public S3 bucket for storing images
AWS_PUBLIC_BUCKET_NAME=100cims-images

# AWS IAM credentials with S3 write permissions
MY_AWS_ACCESS_KEY=AKIA...
AWS_ACCESS_SECRET_KEY=...

# ============================================================================
# GOOGLE SHEETS INTEGRATION (Required for logging)
# ============================================================================
# Used for logging errors, suggestions, and email signups to Google Sheets
# Create a service account and download the credentials JSON
# https://console.cloud.google.com/iam-admin/serviceaccounts

# Service account email from your Google Cloud project
SHEETS_CLIENT_EMAIL=service-account@project-id.iam.gserviceaccount.com

# Base64-encoded private key from service account JSON
# Get this from the "private_key" field in your service account JSON, then encode:
# echo -n "YOUR_PRIVATE_KEY" | base64
SHEETS_PRIVATE_KEY=base64-encoded-private-key-here

# Google Spreadsheet ID (hardcoded in code: 1FL4Tl4VBnafBtHVRBTwfzhFrPRViVwF_6DE6OxIyCBs)
# The spreadsheet should have these sheets configured:
# - "[Emails] 2025" - for email signup tracking
# - "[Errors] 2025" - for error logging
# - "[Suggestions] 2025" - for user suggestions
# Ensure the service account has editor access to this spreadsheet

# ============================================================================
# DISCORD NOTIFICATIONS (Optional)
# ============================================================================
# Webhook URLs for live notifications. Leave empty to disable any of them.
# Create webhooks via Server Settings → Integrations → Webhooks in Discord.

# Fired when a brand-new user signs up via /api/join
DISCORD_NEW_USER_WEBHOOK_URL=

# Fired on API errors (onError hook) and app-client errors (POST /api/log-error)
DISCORD_ERRORS_WEBHOOK_URL=

# Fired when a user submits a suggestion via POST /api/suggestion
DISCORD_CONTACT_WEBHOOK_URL=

# ============================================================================
# APP CONFIGURATION (Required)
# ============================================================================
# Application name used in S3 key paths and logging
APP_NAME=100cims
