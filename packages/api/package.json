{
  "name": "@100cims/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && yarn db:migrate",
    "start": "next start",
    "lint": "eslint src",
    "generate-api-types": "openapi-typescript http://localhost:3000/api/swagger/json -o ./types/api.ts",
