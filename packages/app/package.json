{
  "name": "@100cims/app",
  "main": "expo-router/entry",
  "version": "3.1.0",
  "private": false,
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "npx expo start --clear",
    "start:prod": "npx expo start --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "translations:extract": "formatjs extract './{components,app,hooks,lib,domains}/**/*.ts*' --ignore='**/*.d.ts' --out-file translations/raw-en.json",
    "translations:generate": "formatjs compile './translations/raw-en.json' --out-file translations/en.json",
    "translations": "yarn translations:extract && yarn translations:generate",
    "generate-api-types": "openapi-typescript http://localhost:3000/api/swagger/json -o ./types/api.ts",
    "db:local:up": "docker-compose up -d",
    "build:development:ios": "npx expo run:ios",
    "build:development:android": "npx expo run:android"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@rnmapbox/maps": "10.3.1",
    "@tanstack/react-query": "5.99.0",
    "date-fns": "4.1.0",
    "dotenv": "16.4.7",
    "@howincodes/expo-dynamic-app-icon": "3.0.2",
    "expo": "56.0.8",
    "expo-apple-authentication": "56.0.4",
    "expo-application": "56.0.3",
    "expo-auth-session": "56.0.13",
    "expo-blur": "56.0.3",
