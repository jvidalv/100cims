    "expo-web-browser": "56.0.5",
    "lucide-react-native": "1.8.0",
    "nativewind": "5.0.0-preview.4",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intl": "7.1.0",
