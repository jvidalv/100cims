    "expo-updates": "~55.0.20",
    "expo-web-browser": "~55.0.14",
    "lucide-react-native": "^1.8.0",
    "nativewind": "^5.0.0-preview.3",
    "openapi-fetch": "0.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-intl": "7.1.0",
    "react-native": "0.83.4",
    "react-native-css": "^3.0.7",
