{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.16.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  }
}
