APP_NAME=100cims

EXPO_PUBLIC_API_URL=http://192.168.0.132:8081

EXPO_PUBLIC_ANDROID_CLIENT_ID=
EXPO_PUBLIC_IOS_CLIENT_ID=
EXPO_PUBLIC_WEB_CLIENT_ID=

# Mapbox: pk.* token, public scopes only (ships in client bundle).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Mapbox: sk.* token with DOWNLOADS:READ scope. Build-time only — used by
# the @rnmapbox/maps config plugin to install the iOS SDK. Never bundled.
MAPBOX_DOWNLOADS_TOKEN=

EXPO_PUBLIC_DISCORD_ERROR_WEBHOOK=
EXPO_PUBLIC_DISCORD_CONTACT_WEBHOOK=


